{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backend",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "php -S localhost:3333 index.php",
        "cwd": "apps/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node lint.mjs",
        "cwd": "apps/backend"
      },
      "inputs": ["default"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "php test/run.php",
        "cwd": "apps/backend"
      },
      "inputs": ["default"],
      "cache": true
    }
  }
}
